AC_ISA(parsed_archc_isa) {
  ac_format Type_VV = "%funct6:6 %vm:1 %vs2:5 %vs1:5 %funct3:3 %vd:5 %opcode:7";
  ac_format Type_VX = "%funct6:6 %vm:1 %vs2:5 %rs1:5 %funct3:3 %vd:5 %opcode:7";
  ac_format Type_VI = "%funct6:6 %vm:1 %vs2:5 %imm:5 %funct3:3 %vd:5 %opcode:7";
  ac_format Type_MVV = "%funct6:6 %vm:1 %vs2:5 %vs1:5 %funct3:3 %vd:5 %opcode:7";

  // Instruction Declarations
  ac_instr<Type_MVV> vclz_m_0;
  ac_instr<Type_VI> vor_vi_1;
  ac_instr<Type_VX> vxor_vx_2;
  ac_instr<Type_VX> vmin_vx_3;
  ac_instr<Type_VX> vsadd_vx_4;
  ac_instr<Type_VX> vsra_vx_5;
  ac_instr<Type_VX> vrem_vx_6;
  ac_instr<Type_MVV> vabs_m_7;
  ac_instr<Type_MVV> vclz_m_8;
  ac_instr<Type_VX> vsrl_vx_9;
  ac_instr<Type_MVV> vcpop_m_10;
  ac_instr<Type_MVV> vcpop_m_11;
  ac_instr<Type_VV> vrem_vv_12;
  ac_instr<Type_VX> vxor_vx_13;
  ac_instr<Type_VX> vmax_vx_14;
  ac_instr<Type_VV> vrem_vv_15;
  ac_instr<Type_VX> vxor_vx_16;
  ac_instr<Type_VV> vdiv_vv_17;
  ac_instr<Type_MVV> vabs_m_18;
  ac_instr<Type_VV> vxor_vv_19;
  ac_instr<Type_MVV> vclz_m_20;
  ac_instr<Type_MVV> vnot_m_21;
  ac_instr<Type_VV> vmin_vv_22;
  ac_instr<Type_MVV> vcpop_m_23;
  ac_instr<Type_VX> vor_vx_24;
  ac_instr<Type_VV> vmul_vv_25;
  ac_instr<Type_MVV> vcpop_m_26;
  ac_instr<Type_VX> vdiv_vx_27;
  ac_instr<Type_MVV> vclz_m_28;
  ac_instr<Type_VX> vsrl_vx_29;
  ac_instr<Type_VV> vsadd_vv_30;
  ac_instr<Type_VX> vadd_vx_31;

  ac_asm_map reg {
    "$"[0..31] = [0..31];
    "v"[0..31] = [0..31];
  }

  ISA_CTOR(parsed_archc_isa) {
    vclz_m_0.set_asm("vclz_m_0 %vd, %vs2, %vs1");
    vclz_m_0.set_decoder(funct6=0, funct3=2, opcode=0x57);
    vor_vi_1.set_asm("vor_vi_1 %vd, %vs2, %imm");
    vor_vi_1.set_decoder(funct6=1, funct3=3, opcode=0x57);
    vxor_vx_2.set_asm("vxor_vx_2 %vd, %vs2, %rs1");
    vxor_vx_2.set_decoder(funct6=2, funct3=4, opcode=0x57);
    vmin_vx_3.set_asm("vmin_vx_3 %vd, %vs2, %rs1");
    vmin_vx_3.set_decoder(funct6=3, funct3=4, opcode=0x57);
    vsadd_vx_4.set_asm("vsadd_vx_4 %vd, %vs2, %rs1");
    vsadd_vx_4.set_decoder(funct6=4, funct3=4, opcode=0x57);
    vsra_vx_5.set_asm("vsra_vx_5 %vd, %vs2, %rs1");
    vsra_vx_5.set_decoder(funct6=5, funct3=4, opcode=0x57);
    vrem_vx_6.set_asm("vrem_vx_6 %vd, %vs2, %rs1");
    vrem_vx_6.set_decoder(funct6=6, funct3=4, opcode=0x57);
    vabs_m_7.set_asm("vabs_m_7 %vd, %vs2, %vs1");
    vabs_m_7.set_decoder(funct6=7, funct3=2, opcode=0x57);
    vclz_m_8.set_asm("vclz_m_8 %vd, %vs2, %vs1");
    vclz_m_8.set_decoder(funct6=8, funct3=2, opcode=0x57);
    vsrl_vx_9.set_asm("vsrl_vx_9 %vd, %vs2, %rs1");
    vsrl_vx_9.set_decoder(funct6=9, funct3=4, opcode=0x57);
    vcpop_m_10.set_asm("vcpop_m_10 %vd, %vs2, %vs1");
    vcpop_m_10.set_decoder(funct6=10, funct3=2, opcode=0x57);
    vcpop_m_11.set_asm("vcpop_m_11 %vd, %vs2, %vs1");
    vcpop_m_11.set_decoder(funct6=11, funct3=2, opcode=0x57);
    vrem_vv_12.set_asm("vrem_vv_12 %vd, %vs2, %vs1");
    vrem_vv_12.set_decoder(funct6=12, funct3=0, opcode=0x57);
    vxor_vx_13.set_asm("vxor_vx_13 %vd, %vs2, %rs1");
    vxor_vx_13.set_decoder(funct6=13, funct3=4, opcode=0x57);
    vmax_vx_14.set_asm("vmax_vx_14 %vd, %vs2, %rs1");
    vmax_vx_14.set_decoder(funct6=14, funct3=4, opcode=0x57);
    vrem_vv_15.set_asm("vrem_vv_15 %vd, %vs2, %vs1");
    vrem_vv_15.set_decoder(funct6=15, funct3=0, opcode=0x57);
    vxor_vx_16.set_asm("vxor_vx_16 %vd, %vs2, %rs1");
    vxor_vx_16.set_decoder(funct6=16, funct3=4, opcode=0x57);
    vdiv_vv_17.set_asm("vdiv_vv_17 %vd, %vs2, %vs1");
    vdiv_vv_17.set_decoder(funct6=17, funct3=0, opcode=0x57);
    vabs_m_18.set_asm("vabs_m_18 %vd, %vs2, %vs1");
    vabs_m_18.set_decoder(funct6=18, funct3=2, opcode=0x57);
    vxor_vv_19.set_asm("vxor_vv_19 %vd, %vs2, %vs1");
    vxor_vv_19.set_decoder(funct6=19, funct3=0, opcode=0x57);
    vclz_m_20.set_asm("vclz_m_20 %vd, %vs2, %vs1");
    vclz_m_20.set_decoder(funct6=20, funct3=2, opcode=0x57);
    vnot_m_21.set_asm("vnot_m_21 %vd, %vs2, %vs1");
    vnot_m_21.set_decoder(funct6=21, funct3=2, opcode=0x57);
    vmin_vv_22.set_asm("vmin_vv_22 %vd, %vs2, %vs1");
    vmin_vv_22.set_decoder(funct6=22, funct3=0, opcode=0x57);
    vcpop_m_23.set_asm("vcpop_m_23 %vd, %vs2, %vs1");
    vcpop_m_23.set_decoder(funct6=23, funct3=2, opcode=0x57);
    vor_vx_24.set_asm("vor_vx_24 %vd, %vs2, %rs1");
    vor_vx_24.set_decoder(funct6=24, funct3=4, opcode=0x57);
    vmul_vv_25.set_asm("vmul_vv_25 %vd, %vs2, %vs1");
    vmul_vv_25.set_decoder(funct6=25, funct3=0, opcode=0x57);
