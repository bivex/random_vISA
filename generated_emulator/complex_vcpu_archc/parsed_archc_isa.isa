    vdiv_vx_27.set_asm("vdiv_vx_27 %vd, %vs2, %rs1");
    vdiv_vx_27.set_decoder(funct6=27, funct3=4, opcode=0x57);
    vclz_m_28.set_asm("vclz_m_28 %vd, %vs2, %vs1");
    vclz_m_28.set_decoder(funct6=28, funct3=2, opcode=0x57);
    vsrl_vx_29.set_asm("vsrl_vx_29 %vd, %vs2, %rs1");
    vsrl_vx_29.set_decoder(funct6=29, funct3=4, opcode=0x57);
    vsadd_vv_30.set_asm("vsadd_vv_30 %vd, %vs2, %vs1");
    vsadd_vv_30.set_decoder(funct6=30, funct3=0, opcode=0x57);
    vadd_vx_31.set_asm("vadd_vx_31 %vd, %vs2, %rs1");
    vadd_vx_31.set_decoder(funct6=31, funct3=4, opcode=0x57);
  };
};